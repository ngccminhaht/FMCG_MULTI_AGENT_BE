# Leave empty to use Vite's same-origin /api proxy during local development.
VITE_API_BASE_URL=

# Local demo only. VITE_* values are bundled into the browser; never place a production token here.
VITE_LOCAL_SALES_TOKEN=dev-hung-001

# Used only by vite.config.ts; it is not exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:8000
