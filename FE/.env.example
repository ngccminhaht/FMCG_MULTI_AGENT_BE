# Android emulator normally reaches the Windows host API through 10.0.2.2.
# iOS simulator can use http://localhost:8000.
# A physical device MUST use your computer's reachable LAN IP, e.g. http://192.168.1.10:8000.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_LOCAL_SALES_TOKEN=dev-hung-001
